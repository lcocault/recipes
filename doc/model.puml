@startuml
' PlantUML class diagram for Recipes & Cost Calculator with Domains

package "Ingredient Reference System" as IRS {

  enum IngredientType {
    ENERGY
    FOOD
    MANPOWER
    PACKAGING
    OTHER
  }

  class Ingredient {
    + id: UUID
    + name: String
    + defaultUnit: String
    + purchaseUnit: String
    + currency: String
    + density?: Float
    + notes?: String
  }
  Ingredient -- "1..1" IngredientType: type

  class IngredientPriceHistory {
    + id: UUID
    + ingredientId: UUID
    + pricePerPurchaseUnit: Decimal
    + effectiveDate: DateTime
  }

}

package "Recipe Management System" as RMS {
  class Recipe {
    + id: UUID
    + title: String
    + servings: Integer
    + yieldFactor?: Float
    + steps: Text
    + notes?: String
    + ingredients: List<RecipeIngredient>
  }

  class RecipeIngredient {
    + ingredientId: UUID
    + quantity: Decimal
    + unit: String
    + yieldLossPercent?: Float
  }
}

package "Cost/History Management System" as CHMS {
  class RecipeCostSnapshot {
    + id: UUID
    + recipeId: UUID
    + calculatedAt: DateTime
    + ingredientCosts: JSON
    + packagingCost: Decimal
    + laborCost: Decimal
    + energyCost: Decimal
    + overhead: Decimal
    + totalCost: Decimal
    + perPortionCost: Decimal
  }

  class SalesRecord {
    + id: UUID
    + recipeId: UUID
    + soldAt: DateTime
    + quantity: Integer
    + salePricePerPortion: Decimal
  }
}

' Relationships
IRS.Ingredient "1" -- "0..*" IRS.IngredientPriceHistory : priceHistory
RMS.Recipe "1" -- "0..*" RMS.RecipeIngredient : has
RMS.RecipeIngredient "*" -- "1" IRS.Ingredient : references
RMS.Recipe "1" -- "0..*" CHMS.RecipeCostSnapshot : snapshots
RMS.Recipe "1" -- "0..*" CHMS.SalesRecord : sales


@enduml
